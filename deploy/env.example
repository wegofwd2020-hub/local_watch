# local_watch deploy configuration — copy to ~/.config/local_watch/env and edit.
#
#   mkdir -p ~/.config/local_watch
#   cp deploy/env.example ~/.config/local_watch/env
#
# Every unit in this directory reads this file, so the checkout path is set
# once here instead of being edited into three unit files. systemd does NOT
# expand ~ or $HOME inside an EnvironmentFile: use absolute paths.
#
# The units declare this file WITHOUT a leading "-", so a missing or empty
# LOCAL_WATCH_HOME fails the unit loudly rather than silently collecting
# nothing — same fail-closed principle the collectors follow.

# Absolute path to this repo checkout (the one containing .venv/).
LOCAL_WATCH_HOME=/home/sivam/Documents/code/projects/AIStuff/STEM_studybuddy/local_watch

# Where snapshots, the store and the rendered dashboard live. The dashboard
# path is load-bearing: wegofwd-hub's "Local Watch" tile reads exactly
# $LOCAL_WATCH_DATA/dashboard.html with LOCAL_WATCH_DATA at its default.
LOCAL_WATCH_DATA=/home/sivam/.local/share/local_watch

# Aggregator, as user@host on the tailnet. Used only by local_watch-sync.
# MagicDNS name only — never a public or LAN address.
# Leave unset on mambakkam itself (it has nothing to sync to).
LOCAL_WATCH_REMOTE=sivam@mambakkam.tail242406.ts.net
