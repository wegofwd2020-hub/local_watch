# local_watch-collect.service — systemd USER unit (Linux)
#
# Runs a single read-only collection pass and writes a snapshot JSON to the
# local spool directory. Does NOT sync anywhere (see local_watch-sync) and
# does NOT install or enable itself — see deploy/README.md.
#
# Configuration lives in ~/.config/local_watch/env (see deploy/env.example);
# nothing below needs editing. The hostname is taken from `hostname -s` here
# and in local_watch-sync so both agree on the filename — systemd's %H is the
# FULL hostname, which on some boxes would write foo.local.json while the sync
# step looked for foo.json.
#
# Type=oneshot, triggered by local_watch-collect.timer. Starting it by hand
# once is harmless: collect only runs read-only probes.

[Unit]
Description=local_watch: collect one read-only snapshot of this machine
Documentation=file:///%h/.config/local_watch/env

[Service]
Type=oneshot
EnvironmentFile=%h/.config/local_watch/env
ExecStartPre=/bin/sh -c 'mkdir -p "$LOCAL_WATCH_DATA/spool"'
ExecStart=/bin/sh -c 'exec "$LOCAL_WATCH_HOME/.venv/bin/local_watch" collect \
  --machine "$(hostname -s)" \
  --out "$LOCAL_WATCH_DATA/spool/$(hostname -s).json"'

# Defense in depth: this unit never needs network, never needs write access
# outside $LOCAL_WATCH_DATA, and runs as the invoking user (systemd --user
# units always do). It grants no elevated privileges.
PrivateTmp=true
NoNewPrivileges=true
