<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.wegofwd.localwatch.plist — macOS LaunchAgent

  Runs one read-only local_watch collect pass every 20 minutes
  (StartInterval=1200) and writes the snapshot to the local spool directory.
  Does NOT sync anywhere on its own — see deploy/README.md step 3.

  ONE EDIT NEEDED before installing: replace /Users/YOURUSER below with the
  real home directory (launchd expands neither ~ nor $HOME in these paths).

  Everything else resolves at runtime. The command is wrapped in `sh -c` so
  the hostname comes from `hostname -s`, matching what the Linux units and the
  sync step use — the previous %HOST% placeholder had to be substituted by
  hand and silently produced a filename mismatch if the short and full
  hostnames differed.

  Not loaded automatically; copying it into ~/Library/LaunchAgents and running
  launchctl load is an operator step. To stop:
    launchctl unload ~/Library/LaunchAgents/com.wegofwd.localwatch.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.wegofwd.localwatch</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>mkdir -p "$HOME/.local/share/local_watch/spool" &amp;&amp; exec /Users/YOURUSER/local_watch/.venv/bin/local_watch collect --machine "$(hostname -s)" --out "$HOME/.local/share/local_watch/spool/$(hostname -s).json"</string>
    </array>

    <key>StartInterval</key>
    <integer>1200</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/YOURUSER/.local/share/local_watch/collect.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/YOURUSER/.local/share/local_watch/collect.err.log</string>
</dict>
</plist>
