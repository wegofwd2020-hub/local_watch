<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.wegofwd.localwatch.plist — macOS LaunchAgent: collect

  Runs one read-only local_watch collect pass every 20 minutes
  (StartInterval=1200) and writes a snapshot to the local spool directory.
  Does not sync anywhere — that is com.wegofwd.localwatch-sync.plist.

  NO EDITS NEEDED. Every path is read at runtime from
  ~/.config/local_watch/env, the same file the Linux units use, so the
  checkout location is configured in exactly one place per machine.
  launchd expands neither ~ nor $HOME in plist values, hence the sh -c
  wrapper: sourcing the env file inside the shell is what makes this
  portable without hand-substituting a home directory.

  Install: see deploy/INSTALL-macos.md
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.wegofwd.localwatch</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>
          if [ ! -f "$HOME/.config/local_watch/env" ]; then
            echo "local_watch: missing $HOME/.config/local_watch/env (see deploy/INSTALL-macos.md)" &gt;&amp;2
            exit 1
          fi
          . "$HOME/.config/local_watch/env"
          : "${LOCAL_WATCH_DATA:=$HOME/.local/share/local_watch}"
          mkdir -p "$LOCAL_WATCH_DATA/spool"
          exec &gt;&gt;"$LOCAL_WATCH_DATA/collect.log" 2&gt;&amp;1
          echo "--- collect $(date -u +%Y-%m-%dT%H:%M:%SZ)"
          exec "$LOCAL_WATCH_HOME/.venv/bin/local_watch" collect \
            --machine "$(hostname -s)" \
            --out "$LOCAL_WATCH_DATA/spool/$(hostname -s).json"
        </string>
    </array>

    <key>StartInterval</key>
    <integer>1200</integer>

    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
